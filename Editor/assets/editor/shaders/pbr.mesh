#version 460
#extension GL_EXT_mesh_shader         : require
#extension GL_ARB_shader_draw_parameters : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_nonuniform_qualifier : enable

#include "includes/common.glsl"

// ================================================================
// pbr.mesh  —  mesh shader replacement for pbr.vert
//
// Output interface mirrors pbr.vert exactly:
//   location 0  vec3  vColor
//   location 1  vec2  vUV
//   location 2  vec3  vPosWS
//   location 3  vec3  vNormalWS
//   location 4  vec3  vTangentWS
//   location 5  vec3  vBitangentWS
//   location 6  flat int vObjectIndex
//
// pbr.frag is UNCHANGED.
// ================================================================

layout(local_size_x = 64) in;
layout(triangles, max_vertices = 64, max_primitives = 84) out;

// ----------------------------------------------------------------
// Set 0 — global data  (identical binding to pbr.vert)
// ----------------------------------------------------------------
layout(set = 0, binding = 0) uniform GlobalData {
    CameraData camera;
    WorldData  world;
} ubo_globalData;

// ----------------------------------------------------------------
// Set 2, binding 0 — per-object SSBO  (identical to pbr.vert)
// ----------------------------------------------------------------
layout(set = 2, binding = 0, std430) readonly buffer PerObjectSSBO {
    PerObjectData data[];
} ssbo_objects;

// ----------------------------------------------------------------
// Set 2, bindings 1-4 — mesh shader geometry SSBOs
// ----------------------------------------------------------------

// Packed vertex — must match VertexFormatTangent C++ memory layout.
// The C++ struct is:
//   vec3 position  (12 bytes)
//   vec4 color     (16 bytes)
//   vec2 tex_coord (8  bytes)
//   vec3 normal    (12 bytes)
//   vec3 tangent   (12 bytes)
//   vec3 bitangent (12 bytes)
// Total: 72 bytes, std430 aligned.
struct PackedVertex {
    vec3 position;    // offset 0,  size 12
    vec4 color;       // offset 16, size 16  (naturally aligned in C++ too)
    vec2 tex_coord;   // offset 32, size 8
    vec3 normal;      // offset 40, size 12  (C++ packs here, scalar layout matches)
    vec3 tangent;     // offset 52, size 12
    vec3 bitangent;   // offset 64, size 12
};   
struct MeshletData {
    uint  vertex_offset;
    uint  index_offset;
    uint  vertex_count;
    uint  triangle_count;
    vec3  bounding_sphere_center;
    float bounding_sphere_radius;
};

struct DrawArgs {
    uint meshlet_index;
    uint instance_index;
};

layout(set = 2, binding = 1, scalar) readonly buffer VertexSSBO   { PackedVertex vertices[];    };
layout(set = 2, binding = 2, scalar) readonly buffer IndexSSBO    { uint         prim_indices[]; }; // u32 per element; 3 per triangle packed as indices[base+0..2]
layout(set = 2, binding = 3, scalar) readonly buffer MeshletSSBO  { MeshletData  meshlets[];     };
layout(set = 2, binding = 4, scalar) readonly buffer DrawArgsSSBO { DrawArgs     draw_args[];    };

// ----------------------------------------------------------------
// Per-vertex outputs — exact names and locations from pbr.vert
// ----------------------------------------------------------------
layout(location = 0) out vec3     vColor[];
layout(location = 1) out vec2     vUV[];
layout(location = 2) out vec3     vPosWS[];
layout(location = 3) out vec3     vNormalWS[];
layout(location = 4) out vec3     vTangentWS[];
layout(location = 5) out vec3     vBitangentWS[];
layout(location = 6) out flat int vObjectIndex[];

void main()
{
    // gl_DrawID        → which instance (indexes draw_args[])
    // gl_WorkGroupID.x → which meshlet within that instance
    DrawArgs    da      = draw_args[gl_DrawID];
    MeshletData meshlet = meshlets[da.meshlet_index + gl_WorkGroupID.x];  // ADD + gl_WorkGroupID.x
    uint objectIndex    = da.instance_index;

    uint vertex_count   = meshlet.vertex_count;
    uint triangle_count = meshlet.triangle_count;

    SetMeshOutputsEXT(vertex_count, triangle_count);

    PerObjectData pd = ssbo_objects.data[objectIndex];

    mat4 mvp        = ubo_globalData.camera.projection * ubo_globalData.camera.view * pd.model;
    mat3 normalMat  = mat3(transpose(inverse(pd.model)));

    // ---- Emit vertices (each thread handles stride-32 elements) ----
    for (uint v = gl_LocalInvocationID.x; v < vertex_count; v += gl_WorkGroupSize.x)
    {
        PackedVertex pv = vertices[meshlet.vertex_offset + v];

        vec4 posWS = pd.model * vec4(pv.position, 1.0);
        vPosWS[v]  = posWS.xyz;

        gl_MeshVerticesEXT[v].gl_Position = mvp * vec4(pv.position, 1.0);

        // Replicate the TBN logic from pbr.vert exactly
        vec3 N = normalize(normalMat * pv.normal);
        vec3 T = normalize(normalMat * pv.tangent);
        vec3 B = normalize(normalMat * pv.bitangent);

        // Gram-Schmidt re-orthogonalisation
        T = normalize(T - dot(T, N) * N);
        float handedness = dot(cross(N, T), B) < 0.0 ? -1.0 : 1.0;
        B = normalize(cross(N, T) * handedness);

        vNormalWS[v]    = N;
        vTangentWS[v]   = T;
        vBitangentWS[v] = B;

        vColor[v]       = pv.color.rgb;   // pbr.vert passes vec3 color
        vUV[v]          = pv.tex_coord;
        vObjectIndex[v] = int(objectIndex);
    }

    // ---- Emit triangles ----
    for (uint t = gl_LocalInvocationID.x; t < triangle_count; t += gl_WorkGroupSize.x)
    {
        uint base = meshlet.index_offset + t * 3u;
        gl_PrimitiveTriangleIndicesEXT[t] = uvec3(
            prim_indices[base + 0u],
            prim_indices[base + 1u],
            prim_indices[base + 2u]);
    }
}
